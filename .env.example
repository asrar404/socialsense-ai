# Flask
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# PostgreSQL (V10)
DATABASE_URL=postgresql://socialsense:socialsense@localhost:5432/socialsense
POSTGRES_DB=socialsense
POSTGRES_USER=socialsense
POSTGRES_PASSWORD=socialsense
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false

# Redis (V10)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_WORKER_CONCURRENCY=4
USE_CELERY=false

# YouTube API
YOUTUBE_API_KEY=

# Reddit API (optional - enables live Reddit analysis)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SocialSenseAI/1.0

# Job Settings
MAX_CONCURRENT_JOBS=4
MAX_JOBS_PER_USER=20
MAX_JOB_RUNTIME=600
JOB_HISTORY_RETENTION_DAYS=30
MAX_JOB_RETRIES=3

# Transcript Analysis (V7)
ENABLE_TRANSCRIPT_ANALYSIS=true
TRANSCRIPT_LANGUAGE_PRIORITY=en,en-US,en-GB,en-IN,hi
ENABLE_TRANSCRIPT_FALLBACK_DEMO=true
TRANSCRIPT_CACHE_ENABLED=true
TRANSCRIPT_RETENTION_DAYS=90

# Entity Intelligence (V8)
ENABLE_ENTITY_ANALYSIS=true
ENABLE_ENTITY_SENTIMENT=true
ENABLE_ENTITY_RISK=true
MAX_ENTITIES_PER_ANALYSIS=100
ENTITY_MIN_IMPORTANCE=5

# Channel Context Intelligence (V9)
ENABLE_CHANNEL_INTELLIGENCE=true
ENABLE_HISTORICAL_CONTEXT=true
MAX_HISTORY_VIDEOS=100
MAX_ENTITY_HISTORY=500

# Authenticity Intelligence (V11)
ENABLE_MEDIA_ANALYSIS=true
ENABLE_THUMBNAIL_ANALYSIS=true
ENABLE_AUDIO_ANALYSIS=true
ENABLE_FRAME_ANALYSIS=true
ENABLE_METADATA_ANALYSIS=true
ENABLE_AUTHENTICITY_ENGINE=true
MAX_VIDEO_FRAMES=30
